{
  // Vercel type-checks api/ and middleware.ts with the root tsconfig, so inherit it; it also runs
  // api/ as unbundled Node ESM, so relative imports need explicit .js extensions (NodeNext).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false
  },
  "include": ["api", "middleware.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
